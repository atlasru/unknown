{
  "name": "atlas-workbench",
  "version": "1.0.0",
  "description": "Local evidence analysis, provenance graphs and temporal investigation",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "electron .",
    "test:engine": "python3 -m pytest -q",
    "test:e2e": "playwright test",
    "test:layout": "node --test tests/layout.test.cjs",
    "package": "npm run build && electron-builder --publish never",
    "engine:build": "python3 scripts/build_engine.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atlasru/unknown.git"
  },
  "keywords": [],
  "author": "atlasru",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/atlasru/unknown/issues"
  },
  "homepage": "https://github.com/atlasru/unknown#readme",
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wait-on": "9.5.1"
  },
  "productName": "Atlas",
  "build": {
    "appId": "io.atlasru.atlas",
    "productName": "Atlas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/engine",
        "to": "engine"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Atlas-${version}-windows-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Atlas-${version}-windows-x64-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "Atlas-${version}-linux-${arch}.${ext}",
      "executableName": "atlas",
      "icon": "build/icon.png"
    }
  }
}
